{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian states coloured by NBL MVP team state count",
  "width": 500,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/anthwri/GeoJson-Data/master/australian-states.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/mvp_states.csv"
        },
        "key": "state",
        "fields": ["mvp_team_state_count"]
      }
    },
    {
      "calculate": "datum.mvp_team_state_count == null ? 0 : datum.mvp_team_state_count",
      "as": "mvp_team_state_count"
    }
  ],
  "projection": {
    "type": "mercator",
    "scale": 500,
    "center": [134, -28]
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.5
  },
  "encoding": {
    "color": {
      "field": "mvp_team_state_count",
      "type": "quantitative",
      "title": "NBL MVP team count",
      "scale": {
        "scheme": "blues",
        "zero": true
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State or Territory"
      },
      {
        "field": "mvp_team_state_count",
        "type": "quantitative",
        "title": "MVP team count"
      }
    ]
  }
}